diff --git a/internal/util/icmp/listen_other.go b/internal/util/icmp/listen_other.go
index 7572083..84b8942 100644
--- a/internal/util/icmp/listen_other.go
+++ b/internal/util/icmp/listen_other.go
@@ -1,14 +1,29 @@
-//go:build !windows
+//go:build !windows && !ios
 
 package icmp
 
 import (
 	"net"
+	"os"
 
 	"golang.org/x/net/icmp"
 )
 
 // ListenPacket listens for ICMP packets on the given network and address.
+//
+// Setting GOST_ICMP_UNPRIVILEGED=1 switches to unprivileged ICMP echo sockets
+// (SOCK_DGRAM + IPPROTO_ICMP, networks "udp4"/"udp6"), mirroring the behaviour
+// of the iOS build. This is useful for testing the unprivileged code path on
+// Linux (requires net.ipv4.ping_group_range to permit the current group) and
+// on macOS (where unprivileged ICMP echo sockets are always permitted).
 func ListenPacket(network, address string) (net.PacketConn, error) {
+	if os.Getenv("GOST_ICMP_UNPRIVILEGED") == "1" {
+		switch network {
+		case "ip4:icmp":
+			network = "udp4"
+		case "ip6:ipv6-icmp":
+			network = "udp6"
+		}
+	}
 	return icmp.ListenPacket(network, address)
 }
diff --git a/internal/util/icmp/listen_ios.go b/internal/util/icmp/listen_ios.go
new file mode 100644
index 0000000..5d7873c
--- /dev/null
+++ b/internal/util/icmp/listen_ios.go
@@ -0,0 +1,31 @@
+//go:build ios
+
+package icmp
+
+import (
+        "net"
+
+        "golang.org/x/net/icmp"
+)
+
+// ListenPacket listens for ICMP packets on the given network and address.
+//
+// On iOS, unprivileged processes cannot open raw ICMP sockets (SOCK_RAW).
+// Instead we use unprivileged ICMP echo sockets (SOCK_DGRAM + IPPROTO_ICMP),
+// which the kernel restricts to ICMP echo request/reply traffic — exactly
+// what gost's ICMP transport needs.
+//
+// With SOCK_DGRAM ICMP sockets the kernel assigns the echo identifier itself
+// (visible as the "port" of the local address); the dialer picks it up via
+// KernelEchoID. The gost ICMP relay server mirrors the echo ID in its Echo
+// Reply packets, so this is fully interoperable with a gost server running
+// with raw sockets on Linux/macOS.
+func ListenPacket(network, address string) (net.PacketConn, error) {
+        switch network {
+        case "ip4:icmp":
+                network = "udp4"
+        case "ip6:ipv6-icmp":
+                network = "udp6"
+        }
+        return icmp.ListenPacket(network, address)
+}
