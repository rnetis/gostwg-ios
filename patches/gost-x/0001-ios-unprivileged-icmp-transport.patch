-		ip6:        ip6,
-		PacketConn: conn,
-		id:         id,
+		ip6:          ip6,
+		PacketConn:   conn,
+		id:           id,
+		unprivileged: unprivileged,
 	}
 }
 
+// KernelEchoID returns the ICMP echo identifier assigned by the kernel for
+// unprivileged ICMP echo sockets (SOCK_DGRAM + IPPROTO_ICMP, network udp4/udp6).
+// It returns 0 for raw sockets, where the caller-provided ID is used as-is.
+//
+// On iOS, raw ICMP sockets are unavailable, so gost uses unprivileged ICMP echo
+// sockets and must adopt the kernel-assigned identifier.
+func KernelEchoID(conn net.PacketConn) int {
+	if addr, ok := conn.LocalAddr().(*net.UDPAddr); ok {
+		return addr.Port
+	}
+	return 0
+}
